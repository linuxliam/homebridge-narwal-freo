            },
            "cleaningSensor": {
              "title": "Cleaning sensor",
              "type": "boolean",
              "default": false,
              "description": "Adds an occupancy sensor that shows Detected while the robot is on a cleaning job (from leaving the dock until the job ends, mop-wash visits to the dock included), so Home app automations can react to cleaning (the Home app can't trigger on the vacuum itself). Needs this child bridge paired in the Home app as well."
            },
            "consumables": {
              "title": "Consumables",
              "type": "boolean",
              "default": false,
              "description": "Remaining life of the filter, side brush, rolling brushes, mops and filter sponge, as in the Narwal app's maintenance page (updated hourly and after each clean). Apple's Home app doesn't display these; use a third-party HomeKit app such as Eve or Controller."
            },
            "replaceAtPercent": {
              "title": "Show \"replace\" at (% life left)",
              "type": "integer",
              "default": 10,
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "description": "The robots to show in the Home app, each with its own settings. Without this list, the first robot on the account is used with the settings at the top level (as up to 0.2.x)."
      },
      "securityHold": {
        "title": "Switch the security system from Away to Stay while cleaning",
        "type": "boolean",
        "default": false,
        "description": "Switch the security system from Away to Stay while a robot cleans, and back when it's done. See https://github.com/seanfletchr/homebridge-narwal-freo/blob/main/docs/security-hold.md"
      },
      "securityPlugin": {
        "title": "Security system plugin",
        "type": "string",
        "description": "Package name of an installed plugin that offers the security hold (the settings page lists them)."
      },
      "securityEndpoint": {
        "title": "Security hold endpoint",
        "type": "string",
        "description": "Instead of a plugin: a Unix socket path or http(s) URL answering the security hold API."
      }
    }
  },
