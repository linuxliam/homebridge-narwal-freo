      "serialNumber": {
        "title": "Robot serial number",
        "type": "string",
        "description": "Only needed if the account has more than one robot; pick it above."
      },
      "cleaningSensor": {
        "title": "Cleaning sensor",
        "type": "boolean",
        "default": false,
        "description": "Adds an occupancy sensor that shows Detected while the robot is on a cleaning job (from leaving the dock until the job ends, mop-wash visits to the dock included), so Home app automations can react to cleaning (the Home app can't trigger on the vacuum itself). Needs this child bridge paired in the Home app as well."
      },
      "consumables": {
        "title": "Consumables",
        "type": "boolean",
        "default": false,
        "description": "Remaining life of the filter, side brush, rolling brushes, mops and filter sponge, as in the Narwal app's maintenance page (updated hourly and after each clean). Apple's Home app doesn't display these; use a third-party HomeKit app such as Eve or Controller."
      },
      "replaceAtPercent": {
        "title": "Show \"replace\" at (% life left)",
        "type": "integer",
        "default": 10,
        "minimum": 0,
        "maximum": 100,
        "condition": {
          "functionBody": "return model.consumables === true;"
        }
      },
      "securityHold": {
        "title": "Switch ecobee security from Away to Stay while cleaning",
        "type": "boolean",
        "default": false,
        "description": "Needs homebridge-ecobee-security 0.2.0+ on this Homebridge. When a cleaning job starts, an Away system is switched to Stay (so the motion sensors don't trigger it); when the job ends it goes back to Away. If the security system can't be reached, the clean is refused."
      },
      "region": {
        "title": "Narwal cloud region",
        "type": "string",
        "default": "us",
        "oneOf": [
          {
            "title": "United States / Canada",
            "enum": [
              "us"
            ]
          }
        ],
        "required": true
      }
    }
  },
  "layout": [
    "name",
    "defaultCleanMode",
    "cleaningSensor",
    "consumables",
    {
      "key": "replaceAtPercent",
      "condition": {
        "functionBody": "return model.consumables === true;"
      }
    },
    "securityHold"
  ],
  "customUi": true
}
